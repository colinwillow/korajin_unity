# Plain git (no LFS): the meadow .glb is committed as a normal blob, under GitHub's 100 MB limit.
*.cs   text eol=lf diff=csharp
*.json text eol=lf
*.md   text eol=lf
*.unity  text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset  text eol=lf merge=unityyamlmerge
*.meta   text eol=lf
*.glb  binary
*.gltf binary
*.jpg  binary
*.png  binary
